+fn is_sheng() -> bool {
+    std::fs::read("/sys/firmware/devicetree/base/compatible").is_ok_and(|compatible| {
+        compatible
+            .split(|&byte| byte == 0)
+            .any(|entry| entry == b"xiaomi,sheng")
+    })
+}
+
+fn root_ufs_capacity() -> Option<u64> {
+    let mounts = read_to_string("/proc/self/mountinfo")?;
+    let device = mounts.lines().find_map(|line| {
+        let mut fields = line.split_ascii_whitespace();
+        let device = fields.nth(2)?;
+        (fields.nth(1)? == "/").then_some(device)
+    })?;
+    let block = std::fs::canonicalize(format!("/sys/dev/block/{device}")).ok()?;
+    let disk = if block.join("partition").is_file() {
+        block.parent()?
+    } else {
+        &block
+    };
+    let is_ufs = disk.ancestors().any(|path| {
+        std::fs::read_link(path.join("driver"))
+            .ok()
+            .is_some_and(|driver| driver.file_name() == Some(OsStr::new("ufshcd-qcom")))
+    });
+    if !is_ufs {
+        return None;
+    }
+    // Linux exposes block device size in 512-byte sectors.
+    read_to_string(disk.join("size"))?
+        .trim()
+        .parse::<u64>()
+        .ok()?
+        .checked_mul(512)
+}
+
+fn sheng_display() -> Option<String> {
+    std::fs::read_dir("/sys/class/drm")
+        .ok()?
+        .flatten()
+        .find_map(|connector| {
+            if !connector.file_name().to_str()?.contains("-DSI-") {
+                return None;
+            }
+            let modes = read_to_string(connector.path().join("modes"))?;
+            let (width, height) = modes.lines().next()?.split_once('x')?;
+            let (width, height) = (width.parse::<u32>().ok()?, height.parse::<u32>().ok()?);
+            Some(format!("12.4″ · {width} × {height}"))
+        })
+}
+
+fn sheng_battery_design_capacity() -> Option<String> {
+    let charge = read_to_string("/sys/class/power_supply/qcom-battmgr-bat/charge_full_design")?;
+    let mah = charge.trim().parse::<u64>().ok()? / 1000;
+    (mah > 0).then(|| format!("{mah} mAh"))
 }
 

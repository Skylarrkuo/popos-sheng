+		{"help", no_argument, NULL, 'h'},
+		{0},
+	};
+	int opt, action = 0, slot = -1, lock = -1, rc;
+	bool dry_run = false;
+
+	while ((opt = getopt_long(argc, argv, "hcabnxsmui", long_options, NULL)) != -1) {
+		switch (opt) {
+		case 'h':
+			usage();
+			return 0;
+		case 'D':
+			dry_run = true;
+			break;
+		case 'i':
+			fprintf(stderr, "Ignoring UFS boot LUN failures is no longer supported.\n");
+			return 1;
+		case 'c': case 'a': case 'b': case 'n': case 'x':
+		case 's': case 'm': case 'u':
+			if (action)
+				return usage();
+			action = opt;
+			break;
+		default:
+			return usage();
+		}
+	}

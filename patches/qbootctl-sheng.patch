+		if (slot < 0) {
+			fprintf(stderr, "Expected slot a, b, 0 or 1; got '%s'\n", argv[optind]);
+			return 1;
+		}
+	} else if (action == 's' || action == 'b' || action == 'n') {
+		fprintf(stderr, "A slot is required for -%c.\n", action);
+		return 1;
+	}
+
+	if (geteuid() != 0) {
+		fprintf(stderr, "This program must be run as root!\n");
+		return 1;
+	}

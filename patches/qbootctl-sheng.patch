+		lock = open("/run/qbootctl.lock", O_CREAT | O_RDWR | O_CLOEXEC | O_NOFOLLOW, 0600);
+		if (lock < 0 || flock(lock, LOCK_EX | LOCK_NB)) {
+			fprintf(stderr, "Cannot lock boot metadata: %s\n", strerror(errno));
+			if (lock >= 0)
+				close(lock);
+			return 1;
+		}
+	}

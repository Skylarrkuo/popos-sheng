+static int commit_switch(struct disk_change *changes, size_t count,
+			 uint8_t old_lun, uint8_t new_lun)
+{
+	size_t attempted = 0;
+	bool lun_attempted = false;
+	bool restored = true;
+	int rc = -EIO;
+	sigset_t blocked, original;
+
+	/* Let a normal termination complete the commit or rollback first. */
+	sigemptyset(&blocked);
+	sigaddset(&blocked, SIGINT);
+	sigaddset(&blocked, SIGTERM);
+	sigaddset(&blocked, SIGHUP);
+	sigaddset(&blocked, SIGQUIT);
+	if (sigprocmask(SIG_BLOCK, &blocked, &original))
+		return -errno;
+
+	for (size_t i = 0; i < count; i++)
+		if (gpt_disk_verify(&changes[i].before))
+			goto out;
+	if (old_lun && verify_lun(old_lun))

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "https://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="com.xiaomi.sheng.reboot-android">
    <description>Switch to Android and restart</description>
    <description xml:lang="zh_CN">切换到 Android 并重启</description>
    <message>Administrator authentication is required to switch to Android</message>
    <message xml:lang="zh_CN">切换到 Android 需要管理员验证</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/sheng-reboot-android</annotate>
  </action>
</policyconfig>
